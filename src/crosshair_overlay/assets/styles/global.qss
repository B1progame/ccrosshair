QWidget#PageSurface {
    background: %%PANEL%%;
    border: 1px solid %%BORDER%%;
    border-radius: 16px;
}

QLabel#SidebarSectionLabel {
    color: %%MUTED_TEXT%%;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    padding: 8px 6px 2px 6px;
    text-transform: uppercase;
}

QPushButton#SidebarThemeButton {
    border-radius: 12px;
    padding: 8px 10px;
    font-weight: 600;
    background: %%PANEL_ALT%%;
    border: 1px solid %%BORDER%%;
    color: %%TEXT%%;
}

QPushButton#SidebarThemeButton:hover {
    background: %%HOVER%%;
    border-color: %%ACCENT_MID%%;
}

QFrame#PageHeader {
    margin-bottom: 2px;
}
